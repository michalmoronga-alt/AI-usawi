root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ini,inc}]
end_of_line = crlf

# Prípadná budúca kompatibilita so systémovým Windows PowerShell 5.1.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
